# ── AI Models ────────────────────────────────────────────────
# Gemini — all AI tasks (Thai profiles, English profiles, menu parsing, multilingual)
# Get from: aistudio.google.com → Get API Key
GEMINI_API_KEY=your-gemini-key-here

# ── App ──────────────────────────────────────────────────────
# Your deployed app URL — update after Railway deploy
# Local development: http://localhost:8000
BASE_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────────
# Supabase PostgreSQL — used by SQLModel for all data storage
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── File Storage (photo upload — fill when implementing) ─────
# Supabase Storage — used for vendor photo uploads only
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_PROJECT_URL=https://[project-ref].supabase.co
SUPABASE_ANON_PUBLIC_KEY=your-supabase-anon-public-key
